<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ shop.name | escape }}</title>
    {% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{% endif %}
    {{ 'hp-base.css' | asset_url | stylesheet_tag }}
    {{ 'hp-store.css' | asset_url | stylesheet_tag }}
    <style>body{margin:0;background:#fff}.hp{--hp-ink:{{ settings.hp_ink | default: '#102139' }};--hp-teal:{{ settings.hp_teal | default: '#006B6B' }};--hp-surface:{{ settings.hp_surface | default: '#F4F8F8' }}}</style>
    {{ content_for_header }}
  </head>
  <body><main id="MainContent">{{ content_for_layout }}</main></body>
</html>
