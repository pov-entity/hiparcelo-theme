{{ 'hi-delivery-journey.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hi-delivery-journey.js' | asset_url }}" defer="defer"></script>
{% liquid
  assign shipping_url = section.settings.shipping_link
  if shipping_url == blank
    assign shipping_url = shop.shipping_policy.url
  endif
  if shipping_url == blank
    assign shipping_url = routes.root_url | append: '/pages/shipping' | replace: '//', '/'
  endif
%}
<section class="hpj" id="hi-delivery-journey-{{ section.id }}" aria-labelledby="hpj-title-{{ section.id }}" data-hpj data-hpj-world-url="{{ 'hi-journey-world.js' | asset_url }}" data-hpj-model-url="{{ 'hi-journey-model.js' | asset_url }}" data-hpj-surface="{{ 'hi-journey-materials-color.webp' | asset_url }}" data-hpj-detail="{{ 'hi-journey-materials-detail.webp' | asset_url }}" data-hpj-texture="{{ 'hi-journey-package-2026.webp' | asset_url }}" style="--hpj-desktop-length:{{ section.settings.desktop_length }}svh;--hpj-mobile-length:{{ section.settings.mobile_length }}svh">
  <div class="hpj-intro">
    <p class="hpj-eyebrow">{{ 'hi_journey.eyebrow' | t }}</p>
    <h2 id="hpj-title-{{ section.id }}">{{ 'hi_journey.heading' | t }}</h2>
    <p class="hpj-intro__body">{{ 'hi_journey.introduction' | t }}</p>
  </div>
  <div class="hpj-scroll" data-hpj-track>
    <div class="hpj-pin">
      <div class="hpj-film" aria-hidden="true">
        <canvas class="hpj-canvas" data-hpj-canvas></canvas>
        <div class="hpj-poster" data-hpj-poster><img src="{{ 'hi-journey-package-2026.webp' | asset_url }}" width="1042" height="751" alt="" loading="lazy" decoding="async"></div>
      </div>
      <div class="hpj-toolbar"><span class="hpj-eyebrow">{{ 'hi_journey.story' | t }}</span><a class="hpj-skip" href="#hpj-after-{{ section.id }}" data-hpj-skip>{{ 'hi_journey.skip' | t }} <span aria-hidden="true">↘</span></a></div>
      <div class="hpj-copy">
        <p class="hpj-scene"><span data-hpj-counter>01 / 09</span><span class="hpj-scene__line" aria-hidden="true"></span><span data-hpj-scene-name>{{ 'hi_journey.scenes.preparation' | t }}</span></p>
        <div class="hpj-caption" data-hpj-caption>
          <h3 data-hpj-caption-title>{{ 'hi_journey.captions.preparation' | t }}</h3>
          <p data-hpj-caption-body>{{ 'hi_journey.bodies.preparation' | t }}</p>
        </div>
        <p class="hpj-instruction"><span aria-hidden="true">↓</span> {{ 'hi_journey.scroll' | t }}</p>
      </div>
      <div class="hpj-completion" data-hpj-completion aria-hidden="true">
        <img src="{{ 'hi-journey-approved-logo.png' | asset_url }}" width="1600" height="1600" loading="lazy" decoding="async" alt="{{ 'hi_journey.brand' | t | escape }}">
        <p>{{ 'hi_journey.supporting' | t }}</p>
      </div>
      <div class="hpj-bottom">
        <ol class="hpj-timeline" aria-label="{{ 'hi_journey.static_label' | t }}">
          <li data-hpj-stage="0"><span class="hpj-timeline__number">01</span><div><span class="hpj-timeline__label">{{ 'hi_journey.prep_title' | t }}</span><strong>{{ 'hi_journey.days' | t: count: section.settings.preparation_days }} <small>{{ 'hi_journey.illustrative' | t }}</small></strong></div><span class="hpj-timeline__rail" aria-hidden="true"><i data-hpj-stage-fill></i></span></li>
          <li data-hpj-stage="1"><span class="hpj-timeline__number">02</span><div><span class="hpj-timeline__label">{{ 'hi_journey.flight_title' | t }}</span><strong>{{ 'hi_journey.days' | t: count: section.settings.international_days }} <small>{{ 'hi_journey.illustrative' | t }}</small></strong></div><span class="hpj-timeline__rail" aria-hidden="true"><i data-hpj-stage-fill></i></span></li>
          <li data-hpj-stage="2"><span class="hpj-timeline__number">03</span><div><span class="hpj-timeline__label">{{ 'hi_journey.local_title' | t }}</span><strong>{{ 'hi_journey.days' | t: count: section.settings.delivery_days }} <small>{{ 'hi_journey.illustrative' | t }}</small></strong></div><span class="hpj-timeline__rail" aria-hidden="true"><i data-hpj-stage-fill></i></span></li>
        </ol>
        <p class="hpj-disclosure">{{ 'hi_journey.disclosure' | t }} <a href="{{ shipping_url }}">{{ 'hi_journey.delivery_link' | t }} <span aria-hidden="true">↗</span></a></p>
      </div>
      <script type="application/json" data-hpj-copy>{"titles":[{{ 'hi_journey.captions.preparation' | t | json }},{{ 'hi_journey.captions.dispatch' | t | json }},{{ 'hi_journey.captions.loading' | t | json }},{{ 'hi_journey.captions.ocean' | t | json }},{{ 'hi_journey.captions.arrival' | t | json }},{{ 'hi_journey.captions.truck' | t | json }},{{ 'hi_journey.captions.road' | t | json }},{{ 'hi_journey.captions.house' | t | json }},{{ 'hi_journey.captions.delivered' | t | json }}],"bodies":[{{ 'hi_journey.bodies.preparation' | t | json }},{{ 'hi_journey.bodies.dispatch' | t | json }},{{ 'hi_journey.bodies.loading' | t | json }},{{ 'hi_journey.bodies.ocean' | t | json }},{{ 'hi_journey.bodies.arrival' | t | json }},{{ 'hi_journey.bodies.truck' | t | json }},{{ 'hi_journey.bodies.road' | t | json }},{{ 'hi_journey.bodies.house' | t | json }},{{ 'hi_journey.bodies.delivered' | t | json }}],"scenes":[{{ 'hi_journey.scenes.preparation' | t | json }},{{ 'hi_journey.scenes.dispatch' | t | json }},{{ 'hi_journey.scenes.loading' | t | json }},{{ 'hi_journey.scenes.ocean' | t | json }},{{ 'hi_journey.scenes.arrival' | t | json }},{{ 'hi_journey.scenes.truck' | t | json }},{{ 'hi_journey.scenes.road' | t | json }},{{ 'hi_journey.scenes.house' | t | json }},{{ 'hi_journey.scenes.delivered' | t | json }}]}</script>
    </div>
  </div>
  <div class="hpj-static" data-hpj-static>
    <ol>
      <li><span>01</span><div><h3>{{ 'hi_journey.prep_title' | t }}</h3><strong>{{ 'hi_journey.days' | t: count: section.settings.preparation_days }} · {{ 'hi_journey.illustrative' | t }}</strong><p>{{ 'hi_journey.prep_body' | t }}</p></div></li>
      <li><span>02</span><div><h3>{{ 'hi_journey.flight_title' | t }}</h3><strong>{{ 'hi_journey.days' | t: count: section.settings.international_days }} · {{ 'hi_journey.illustrative' | t }}</strong><p>{{ 'hi_journey.flight_body' | t }}</p></div></li>
      <li><span>03</span><div><h3>{{ 'hi_journey.local_title' | t }}</h3><strong>{{ 'hi_journey.days' | t: count: section.settings.delivery_days }} · {{ 'hi_journey.illustrative' | t }}</strong><p>{{ 'hi_journey.local_body' | t }}</p></div></li>
    </ol>
    <p class="hpj-disclosure">{{ 'hi_journey.disclosure' | t }} <a href="{{ shipping_url }}">{{ 'hi_journey.delivery_link' | t }} ↗</a></p>
  </div>
  <div id="hpj-after-{{ section.id }}" class="hpj-after" tabindex="-1"><p>{{ 'hi_journey.supporting' | t }}</p></div>
  <noscript><style>.hpj-scroll{display:none}.hpj-static{display:block;position:static;width:auto;height:auto;overflow:visible;clip-path:none;padding:20px 5vw 60px}</style></noscript>
</section>
{% schema %}
{
  "name": "t:hi_journey.name",
  "enabled_on": {"templates": ["index"]},
  "settings": [
    {"type":"paragraph","content":"t:hi_journey.estimates_info"},
    {"type":"range","id":"preparation_days","min":1,"max":10,"step":1,"default":2,"label":"t:hi_journey.preparation_days"},
    {"type":"range","id":"international_days","min":1,"max":30,"step":1,"default":7,"label":"t:hi_journey.international_days"},
    {"type":"range","id":"delivery_days","min":1,"max":10,"step":1,"default":2,"label":"t:hi_journey.delivery_days"},
    {"type":"url","id":"shipping_link","label":"t:hi_journey.shipping_link"},
    {"type":"range","id":"desktop_length","min":800,"max":1800,"step":100,"default":1200,"unit":"vh","label":"t:hi_journey.desktop_length"},
    {"type":"range","id":"mobile_length","min":800,"max":1800,"step":100,"default":1400,"unit":"vh","label":"t:hi_journey.mobile_length"}
  ],
  "presets": [{"name":"t:hi_journey.name"}]
}
{% endschema %}
