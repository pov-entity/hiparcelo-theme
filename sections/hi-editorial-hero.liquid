<section class="hi hi-ref-hero" aria-labelledby="hi-ref-hero-title">
  <div class="hi-ref-container">
    <div class="hi-ref-hero__panel">
      <div class="hi-ref-hero__copy">
        <p class="hi-ref-eyebrow">{{ 'hi_edit.hero_kicker' | t }}</p>
        <h1 id="hi-ref-hero-title">{{ 'hi_edit.hero_line_one' | t }} <em>{{ 'hi_edit.hero_line_two' | t }}</em></h1>
        <p class="hi-ref-hero__summary">{{ 'hi_edit.hero_copy' | t }}</p>
        <div class="hi-ref-hero__actions"><a class="hi-ref-button hi-ref-button--light" href="#hi-approach">{{ 'hi_edit.hero_action' | t }}</a><a class="hi-ref-hero__textlink" href="{{ routes.root_url | append: '/pages/first-find' | replace: '//', '/' }}">{{ 'hi_edit.hero_second' | t }} <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="hi-ref-hero__visual">
        <img src="{{ 'hp-hero-concept.webp' | asset_url }}" width="1536" height="1024" loading="eager" fetchpriority="high" alt="{{ 'hiparcelo.hero.concept_alt' | t }}">
        <span class="hi-ref-hero__photo-label">{{ 'hi_edit.concept_notice' | t }}</span>
      </div>
    </div>
    <div class="hi-ref-hero__under"><span>{{ 'hi_edit.hero_bottom' | t }}</span><a href="#hi-feeling">{{ 'hi_edit.hero_scroll' | t }} <span aria-hidden="true">↓</span></a></div>
  </div>
</section>
{% schema %}
{"name":"HiParcelo cover story","settings":[],"presets":[{"name":"HiParcelo cover story"}]}
{% endschema %}