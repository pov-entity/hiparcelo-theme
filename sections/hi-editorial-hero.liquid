<section class="hi hi-ec-hero" aria-labelledby="hi-ec-hero-title">
  <div class="hi-ec-hero__surface">
    <img class="hi-ec-hero__photo" src="{{ 'hp-hero-concept.webp' | asset_url }}" width="1536" height="1024" loading="eager" fetchpriority="high" alt="">
    <div class="hi-ec-hero__grid">
      <div class="hi-ec-hero__copy">
        <span class="hi-ec-pill">{{ 'hi_ec.hero_badge' | t }}</span>
        <h1 id="hi-ec-hero-title">{{ 'hi_ec.hero_line_one' | t }}<span>{{ 'hi_ec.hero_line_two' | t }}</span></h1>
        <p>{{ 'hi_ec.hero_intro' | t }}</p>
        <a class="hi-ec-btn hi-ec-btn--white" href="#hi-feeling">{{ 'hi_ec.hero_action' | t }} <span aria-hidden="true">↗</span></a>
        <div class="hi-ec-hero__status"><i aria-hidden="true"></i>{{ 'hi_ec.hero_status' | t }}</div>
      </div>
      <a class="hi-ec-hero__tile" href="{{ routes.root_url | append: '/pages/about' | replace: '//', '/' }}">
        <span class="hi-ec-hero__thumb" aria-hidden="true"><img src="{{ 'hp-story-concept.webp' | asset_url }}" width="1536" height="1024" loading="lazy" alt=""></span>
        <span class="hi-ec-hero__tile-copy"><small>{{ 'hi_ec.hero_tile_label' | t }}</small><strong>{{ 'hi_ec.hero_tile_title' | t }}</strong><span>{{ 'hi_ec.hero_tile_link' | t }} ↗</span></span>
      </a>
    </div>
    <span class="hi-ec-hero__concept">{{ 'hi_ec.concept_label' | t }}</span>
  </div>
</section>
{% schema %}
{"name":"HiParcelo cover story","settings":[],"presets":[{"name":"HiParcelo cover story"}]}
{% endschema %}
