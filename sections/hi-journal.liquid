<section class="hi hi-ref-guides" id="hi-journal" aria-labelledby="hi-ref-guides-title">
<div class="hi-ref-container">
  <div class="hi-ref-guides__intro"><p class="hi-ref-eyebrow">{{ 'hi_edit.journal_kicker' | t }}</p><h2 id="hi-ref-guides-title">{{ 'hi_edit.journal_head_a' | t }} <em>{{ 'hi_edit.journal_head_b' | t }}</em></h2><p>{{ 'hi_edit.journal_copy' | t }}</p></div>
  <div class="hi-ref-guides__grid">
    <a href="{{ routes.root_url | append: '/pages/guide-before-ordering' | replace: '//', '/' }}" class="hi-ref-guides__card"><span>{{ 'hi_edit.journal_one_label' | t }}</span><span class="hi-ref-guides__graphic" aria-hidden="true">01<span>✦</span></span><h3>{{ 'hi_edit.journal_one' | t }}</h3><p>{{ 'hi_edit.journal_one_copy' | t }}</p><span class="hi-ref-guides__arrow" aria-hidden="true">↗</span></a>
    <a href="{{ routes.root_url | append: '/pages/guide-fit' | replace: '//', '/' }}" class="hi-ref-guides__card"><span>{{ 'hi_edit.journal_two_label' | t }}</span><span class="hi-ref-guides__graphic" aria-hidden="true">02<span>✦</span></span><h3>{{ 'hi_edit.journal_two' | t }}</h3><p>{{ 'hi_edit.journal_two_copy' | t }}</p><span class="hi-ref-guides__arrow" aria-hidden="true">↗</span></a>
    <a href="{{ routes.root_url | append: '/pages/guide-use-and-care' | replace: '//', '/' }}" class="hi-ref-guides__card"><span>{{ 'hi_edit.journal_three_label' | t }}</span><span class="hi-ref-guides__graphic" aria-hidden="true">03<span>✦</span></span><h3>{{ 'hi_edit.journal_three' | t }}</h3><p>{{ 'hi_edit.journal_three_copy' | t }}</p><span class="hi-ref-guides__arrow" aria-hidden="true">↗</span></a>
  </div>
  <a class="hi-ref-inline-link hi-ref-guides__more" href="{{ routes.root_url | append: '/pages/guides' | replace: '//', '/' }}">{{ 'hi_edit.journal_link' | t }} <span aria-hidden="true">↗</span></a>
</div></section>
