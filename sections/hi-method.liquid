<section class="hi hi-ref-method" id="hi-approach" aria-labelledby="hi-ref-method-title">
  <div class="hi-ref-container">
    <div class="hi-ref-method__header"><p class="hi-ref-eyebrow">{{ 'hi_edit.method_kicker' | t }}</p><h2 id="hi-ref-method-title">{{ 'hi_edit.method_head_a' | t }} <em>{{ 'hi_edit.method_head_b' | t }}</em></h2><p>{{ 'hi_edit.method_copy' | t }}</p></div>
    <div class="hi-ref-method__list">
      <details open><summary><span>01</span><strong>{{ 'hi_edit.method_one_q' | t }}</strong><i aria-hidden="true">+</i></summary><div><p>{{ 'hi_edit.method_one_a' | t }}</p></div></details>
      <details><summary><span>02</span><strong>{{ 'hi_edit.method_two_q' | t }}</strong><i aria-hidden="true">+</i></summary><div><p>{{ 'hi_edit.method_two_a' | t }}</p></div></details>
      <details><summary><span>03</span><strong>{{ 'hi_edit.method_three_q' | t }}</strong><i aria-hidden="true">+</i></summary><div><p>{{ 'hi_edit.method_three_a' | t }}</p></div></details>
      <details><summary><span>04</span><strong>{{ 'hi_edit.method_four_q' | t }}</strong><i aria-hidden="true">+</i></summary><div><p>{{ 'hi_edit.method_four_a' | t }}</p></div></details>
    </div>
    <div class="hi-ref-method__foot"><p>{{ 'hi_edit.method_note' | t }}</p><a href="{{ routes.root_url | append: '/pages/about' | replace: '//', '/' }}" class="hi-ref-inline-link">{{ 'hi_edit.method_link' | t }} <span aria-hidden="true">↗</span></a></div>
  </div>
</section>
{% schema %}
{"name":"HiParcelo the method","settings":[],"presets":[{"name":"HiParcelo the method"}]}
{% endschema %}