<section class="hi ha-discovery" id="hi-feeling" aria-labelledby="hi-ec-feature-title"><div class="ha-shell">
  <header class="ha-heading"><p class="ha-eyebrow"><span aria-hidden="true">✦</span> {{ 'hi_ec.feature_badge' | t }}</p><h2 id="hi-ec-feature-title">{{ 'hi_ec.feature_head' | t }} <em>{{ 'hi_ec.feature_head_sub' | t }}</em></h2></header>
  <div class="ha-fan">
    <article class="ha-fan__card"><div class="ha-fan__image"><img src="{{ 'hp-story-concept.webp' | asset_url }}" width="1536" height="1024" loading="lazy" alt=""></div><div class="ha-fan__copy"><span>01</span><h3>{{ 'hi_ec.feature_one_title' | t }}</h3><p>{{ 'hi_ec.feature_one_copy' | t }}</p></div></article>
    <article class="ha-fan__card"><div class="ha-fan__image"><img src="{{ 'hp-atmosphere-arrival-mobile.webp' | asset_url }}" width="840" height="473" loading="lazy" alt=""></div><div class="ha-fan__copy"><span>02</span><h3>{{ 'hi_ec.feature_two_title' | t }}</h3><p>{{ 'hi_ec.feature_two_copy' | t }}</p></div></article>
    <article class="ha-fan__card"><div class="ha-fan__image"><img src="{{ 'hi-journey-photo-packing-mobile.webp' | asset_url }}" width="840" height="560" loading="lazy" alt=""></div><div class="ha-fan__copy"><span>03</span><h3>{{ 'hi_ec.feature_three_title' | t }}</h3><p>{{ 'hi_ec.feature_three_copy' | t }}</p></div></article>
  </div>
  <div class="ha-discovery__end"><a class="ha-button" href="#hi-approach">{{ 'hi_edit.method_link' | t }}<span aria-hidden="true">↗</span></a><p class="ha-note">{{ 'hi_ec.feature_footnote' | t }}</p></div>
</div></section>
{% schema %}
{"name":"HiParcelo discovery cards","settings":[],"presets":[{"name":"HiParcelo discovery cards"}]}
{% endschema %}
