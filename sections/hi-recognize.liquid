<section class="hi hi-ref-banner" id="hi-feeling" aria-labelledby="hi-ref-banner-title">
  <div class="hi-ref-container">
    <div class="hi-ref-banner__panel">
      <img src="{{ 'hp-story-concept.webp' | asset_url }}" alt="" aria-hidden="true" loading="lazy" width="1536" height="1024">
      <div class="hi-ref-banner__content">
        <p class="hi-ref-eyebrow">{{ 'hi_edit.feeling_kicker' | t }}</p>
        <h2 id="hi-ref-banner-title">{{ 'hi_edit.feeling_head_a' | t }} <em>{{ 'hi_edit.feeling_head_b' | t }}</em></h2>
        <p>{{ 'hi_edit.feeling_copy' | t }}</p>
        <a class="hi-ref-button hi-ref-button--light" href="{{ routes.root_url | append: '/pages/about' | replace: '//', '/' }}">{{ 'hi_edit.feeling_link' | t }}</a>
      </div>
      <span class="hi-ref-banner__note">{{ 'hi_edit.concept_notice' | t }}</span>
    </div>
  </div>
</section>
{% schema %}
{"name":"HiParcelo everyday edit","settings":[],"presets":[{"name":"HiParcelo everyday edit"}]}
{% endschema %}