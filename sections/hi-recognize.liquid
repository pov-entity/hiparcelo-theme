<section class="hi hi-ec-feature" id="hi-feeling" aria-labelledby="hi-ec-feature-title"><div class="hi-ec-shell">
  <div class="hi-ec-feature__heading"><span class="hi-ec-feature__kicker">✦ {{ 'hi_ec.feature_badge' | t }}</span><h2 id="hi-ec-feature-title">{{ 'hi_ec.feature_head' | t }}<span>{{ 'hi_ec.feature_head_sub' | t }}</span></h2></div>
  <div class="hi-ec-feature__grid">
    <article class="hi-ec-feature__card hi-ec-feature__card--one">
      <h3>{{ 'hi_ec.feature_one_title' | t }}</h3><p>{{ 'hi_ec.feature_one_copy' | t }}</p>
      <div class="hi-ec-feature__card-illustration"><strong>01.</strong><span>{{ 'hi_ec.feature_one_foot' | t }}</span></div>
    </article>
    <article class="hi-ec-feature__card hi-ec-feature__card--two">
      <img src="{{ 'hp-story-concept.webp' | asset_url }}" class="hi-ec-feature__photo" alt="" width="1536" height="1024" loading="lazy">
      <h3>{{ 'hi_ec.feature_two_title' | t }}</h3><p>{{ 'hi_ec.feature_two_copy' | t }}</p>
      <div class="hi-ec-feature__card-bottom"><a href="{{ routes.root_url | append: '/pages/guide-fit' | replace: '//', '/' }}">{{ 'hi_ec.feature_two_link' | t }} ↗</a><small>{{ 'hi_ec.concept_short' | t }}</small></div>
    </article>
    <article class="hi-ec-feature__card hi-ec-feature__card--three">
      <h3>{{ 'hi_ec.feature_three_title' | t }}</h3><p>{{ 'hi_ec.feature_three_copy' | t }}</p>
      <div class="hi-ec-feature__checklist" role="img" aria-label="{{ 'hi_ec.feature_three_checks' | t }}"><span>01</span><span>02</span><span>03</span><span>04</span></div>
    </article>
  </div>
  <p class="hi-ec-feature__card-foot">{{ 'hi_ec.feature_footnote' | t }}</p>
</div></section>
{% schema %}
{"name":"HiParcelo everyday edit","settings":[],"presets":[{"name":"HiParcelo everyday edit"}]}
{% endschema %}
