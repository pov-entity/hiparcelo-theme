<section class="hi hi-v2-signals" aria-label="{{ 'hi_v2.signals_aria' | t }}">
  <div class="hi-v2-ticker" aria-hidden="true"><div class="hi-v2-ticker__track"><span>{{ 'hi_v2.ticker_a' | t }} ✳ {{ 'hi_v2.ticker_b' | t }} ✳ {{ 'hi_v2.ticker_c' | t }} ✳</span><span>{{ 'hi_v2.ticker_a' | t }} ✳ {{ 'hi_v2.ticker_b' | t }} ✳ {{ 'hi_v2.ticker_c' | t }} ✳</span></div></div>
  <div class="hi-wrap hi-v2-signals__intro">
    <div><span class="hi-v2-eyebrow">HP / 001—003</span><h2>{{ 'hi_v2.signals_head' | t }}<em>{{ 'hi_v2.signals_head_em' | t }}</em></h2></div>
    <p>{{ 'hi_v2.signals_intro' | t }}</p>
  </div>
  <div class="hi-wrap hi-v2-signals__cards">
    <article data-hi-reveal><div class="hi-v2-numeral">01<span aria-hidden="true">↗</span></div><h3>{{ 'hi_v2.signals_a' | t }}</h3><p>{{ 'hi_v2.signals_a_copy' | t }}</p></article>
    <article data-hi-reveal><div class="hi-v2-numeral">02<span aria-hidden="true">↗</span></div><h3>{{ 'hi_v2.signals_b' | t }}</h3><p>{{ 'hi_v2.signals_b_copy' | t }}</p></article>
    <article data-hi-reveal><div class="hi-v2-numeral">03<span aria-hidden="true">↗</span></div><h3>{{ 'hi_v2.signals_c' | t }}</h3><p>{{ 'hi_v2.signals_c_copy' | t }}</p></article>
  </div>
</section>
{% schema %}{"name":"HiParcelo brand signals","settings":[],"presets":[{"name":"HiParcelo brand signals"}]}{% endschema %}