<section class="hi hi-ref-clarity" aria-labelledby="hi-ref-clarity-title"><div class="hi-ref-container">
  <div class="hi-ref-clarity__heading"><p class="hi-ref-eyebrow">{{ 'hi_v2.clarity_kicker' | t }}</p><h2 id="hi-ref-clarity-title">{{ 'hi_v2.clarity_head' | t }} <em>{{ 'hi_v2.clarity_head_em' | t }}</em></h2><p>{{ 'hi_v2.clarity_intro' | t }}</p></div>
  <div class="hi-ref-clarity__links">
    <a href="{{ routes.root_url | append: '/pages/shipping' | replace: '//', '/' }}"><span>01</span><strong>{{ 'hi_v2.clarity_delivery' | t }}</strong><span aria-hidden="true">↗</span></a>
    <a href="{{ routes.root_url | append: '/pages/returns' | replace: '//', '/' }}"><span>02</span><strong>{{ 'hi_v2.clarity_returns' | t }}</strong><span aria-hidden="true">↗</span></a>
    <a href="{{ routes.root_url | append: '/pages/contact' | replace: '//', '/' }}"><span>03</span><strong>{{ 'hi_v2.clarity_support' | t }}</strong><span aria-hidden="true">↗</span></a>
    <a href="{{ routes.root_url | append: '/pages/track-order' | replace: '//', '/' }}"><span>04</span><strong>{{ 'hi_v2.clarity_tracking' | t }}</strong><span aria-hidden="true">↗</span></a>
  </div>
  <p class="hi-ref-clarity__note">{{ 'hi_v2.clarity_note' | t }}</p>
</div></section>
{% schema %}
{"name":"HiParcelo buying clarity","settings":[],"presets":[{"name":"HiParcelo buying clarity"}]}
{% endschema %}