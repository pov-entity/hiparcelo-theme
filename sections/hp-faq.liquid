{% assign default_heading = 'hiparcelo.faq.heading' | t %}
<section class="hp hp-faq" aria-labelledby="hp-faq-title-{{ section.id }}">
  <div class="hp-shell hp-faq__grid">
    <div class="hp-faq__intro">
      <p class="hp-eyebrow">{{ 'hiparcelo.faq.eyebrow' | t }}</p>
      <h2 id="hp-faq-title-{{ section.id }}">{{ section.settings.heading | default: default_heading | escape }}</h2>
      <p class="hp-copy">{{ 'hiparcelo.faq.copy' | t }}</p>
    </div>
    <div class="hp-faq__questions">
      {% for block in section.blocks %}
        {% liquid
          case block.settings.topic
            when 'delivery'
              assign default_question = 'hiparcelo.faq.delivery_question' | t
              assign default_answer = 'hiparcelo.faq.delivery_answer' | t
            when 'returns'
              assign default_question = 'hiparcelo.faq.returns_question' | t
              assign default_answer = 'hiparcelo.faq.returns_answer' | t
            when 'help'
              assign default_question = 'hiparcelo.faq.help_question' | t
              assign default_answer = 'hiparcelo.faq.help_answer' | t
            else
              assign default_question = 'hiparcelo.faq.products_question' | t
              assign default_answer = 'hiparcelo.faq.products_answer' | t
          endcase
        %}
        <details id="hp-faq-{{ block.settings.topic }}"{% if section.settings.open_first and forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | default: default_question | escape }}<span aria-hidden="true"></span></summary>
          <div class="hp-faq__answer">
            <p>{{ block.settings.answer | default: default_answer | escape | newline_to_br }}</p>
            {% if block.settings.topic == 'help' %}
              {% assign support_email = settings.hp_support_email | default: shop.email %}
              {% if support_email != blank %}
                <a href="mailto:{{ support_email | escape }}">{{ support_email | escape }}</a>
              {% endif %}
            {% endif %}
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>
{% stylesheet %}
  .hp-faq { padding-block: 64px; background: #fff; }
  .hp-faq__grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 88px; align-items: start; }
  .hp-faq__intro h2 { margin-top: 13px; max-width: 16ch; }
  .hp-faq__intro p.hp-copy { font-size: 14px; margin-top: 18px; }
  .hp-faq details { border-bottom: 1px solid var(--hp-line); scroll-margin-top: 28px; }
  .hp-faq summary { display: flex; align-items: center; gap: 22px; padding: 20px 0; list-style: none; font-size: 14px; font-weight: 600; cursor: pointer; }
  .hp-faq summary::-webkit-details-marker { display: none; }
  .hp-faq summary > span { position: relative; width: 16px; height: 16px; flex-shrink: 0; margin-left: auto; }
  .hp-faq summary > span::before, .hp-faq summary > span::after { content: ""; position: absolute; background: var(--hp-ink); }
  .hp-faq summary > span::before { top: 7px; left: 1px; width: 14px; height: 2px; }
  .hp-faq summary > span::after { top: 1px; left: 7px; width: 2px; height: 14px; }
  .hp-faq details[open] summary > span::after { display: none; }
  .hp-faq details:target { border-bottom-color: var(--hp-teal); }
  .hp-faq__answer { padding: 0 30px 22px 0; font-size: 14px; color: var(--hp-muted); }
  .hp-faq__answer a { display: inline-block; margin-top: 12px; color: var(--hp-teal); }
  @media (max-width: 749px) {
    .hp-faq { padding-block: 47px; }
    .hp-faq__grid { grid-template-columns: 1fr; gap: 22px; }
  }
{% endstylesheet %}
{% javascript %}
  (() => {
    const revealAnswer = () => {
      if (!window.location.hash.startsWith('#hp-faq-')) return;
      const target = document.getElementById(window.location.hash.slice(1));
      if (target && target.tagName === 'DETAILS') target.open = true;
    };
    window.addEventListener('hashchange', revealAnswer);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', revealAnswer, { once: true });
    else revealAnswer();
  })();
{% endjavascript %}
{% schema %}
{
  "name": "t:hiparcelo.faq.name",
  "limit": 1,
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:hiparcelo.fields.heading" },
    { "type": "checkbox", "id": "open_first", "label": "t:hiparcelo.faq.open_first", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:hiparcelo.faq.block",
      "settings": [
        {
          "type": "select",
          "id": "topic",
          "label": "t:hiparcelo.fields.topic",
          "options": [
            { "value": "products", "label": "t:hiparcelo.faq.products" },
            { "value": "delivery", "label": "t:hiparcelo.faq.delivery" },
            { "value": "returns", "label": "t:hiparcelo.faq.returns" },
            { "value": "help", "label": "t:hiparcelo.faq.help" }
          ],
          "default": "products"
        },
        { "type": "text", "id": "question", "label": "t:hiparcelo.faq.question" },
        { "type": "textarea", "id": "answer", "label": "t:hiparcelo.faq.answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:hiparcelo.faq.name",
      "blocks": [
        { "type": "question", "settings": { "topic": "products" } },
        { "type": "question", "settings": { "topic": "delivery" } },
        { "type": "question", "settings": { "topic": "returns" } },
        { "type": "question", "settings": { "topic": "help" } }
      ]
    }
  ]
}
{% endschema %}
