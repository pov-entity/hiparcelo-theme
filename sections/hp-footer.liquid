{% assign support_email = settings.hp_support_email | default: shop.email %}
<footer class="hp hp-footer">
  <div class="hp-shell">
    <div class="hp-footer__top">
      <div>
        <a class="hp-wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{{ 'hiparcelo.brand.prefix' | t }}<span>{{ 'hiparcelo.brand.suffix' | t }}</span></a>
        <p>{{ 'hiparcelo.footer.tagline' | t }}</p>
      </div>
      <nav aria-label="{{ 'hiparcelo.navigation.footer' | t }}">
        <a href="{{ routes.root_url }}#hp-discovery">{{ 'hiparcelo.navigation.first_find' | t }}</a>
        <a href="{{ routes.root_url }}#hp-about">{{ 'hiparcelo.navigation.about' | t }}</a>
        <a href="{{ routes.root_url }}#hp-help">{{ 'hiparcelo.navigation.help' | t }}</a>
        {% if support_email != blank %}
          <a href="mailto:{{ support_email | escape }}">{{ 'hiparcelo.navigation.contact' | t }}</a>
        {% endif %}
      </nav>
    </div>
    <div class="hp-footer__bottom">
      <div>
        {% assign year = 'now' | date: '%Y' %}
        <p>{{ 'hiparcelo.footer.copyright' | t: year: year, brand: shop.name }}</p>
        {% if settings.hp_seller_identity != blank %}
          <p>{{ settings.hp_seller_identity | escape }}</p>
        {% endif %}
      </div>
      <div class="hp-footer__links">
        {% for policy in shop.policies %}
          {% if policy.body != blank %}
            <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
          {% endif %}
        {% endfor %}
        {% if settings.social_instagram_link != blank %}
          <a href="{{ settings.social_instagram_link | escape }}">{{ 'hiparcelo.footer.instagram' | t }}</a>
        {% endif %}
        {% if settings.social_facebook_link != blank %}
          <a href="{{ settings.social_facebook_link | escape }}">{{ 'hiparcelo.footer.facebook' | t }}</a>
        {% endif %}
        {% if settings.social_tiktok_link != blank %}
          <a href="{{ settings.social_tiktok_link | escape }}">{{ 'hiparcelo.footer.tiktok' | t }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</footer>
{% stylesheet %}
  .hp-footer { background: var(--hp-ink); color: #fff; padding-block: 43px 28px; }
  .hp-footer .hp-wordmark { color: #fff; display: inline-block; }
  .hp-footer .hp-wordmark span { color: #47c4bd; }
  .hp-footer__top { display: flex; justify-content: space-between; align-items: center; gap: 35px; padding-bottom: 35px; }
  .hp-footer__top p { margin-top: 14px; color: #c4d1df; font-size: 13px; }
  .hp-footer nav { display: flex; flex-wrap: wrap; gap: 26px; }
  .hp-footer nav a { font-size: 13px; text-decoration: none; padding-block: 12px; }
  .hp-footer__bottom { display: flex; justify-content: space-between; align-items: start; gap: 28px; padding-top: 24px; border-top: 1px solid #ffffff24; }
  .hp-footer__bottom p { font-size: 11px; color: #c4d1df; margin-bottom: 5px; }
  .hp-footer__links { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 13px 22px; max-width: 60%; }
  .hp-footer__links a { color: #d1dfeb; font-size: 11px; }
  .hp-footer a:focus-visible { outline-color: #68d5cd; }
  @media (max-width: 749px) {
    .hp-footer__top, .hp-footer__bottom { display: block; }
    .hp-footer nav { gap: 12px 24px; margin-top: 23px; }
    .hp-footer__links { justify-content: flex-start; max-width: 100%; margin-top: 20px; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "t:hiparcelo.footer.name",
  "enabled_on": { "groups": ["footer"] },
  "settings": []
}
{% endschema %}
