{% liquid
  assign default_kicker = 'hp_store.common.page_kicker' | t
  assign kicker = section.settings.kicker | default: default_kicker
  assign intro = section.settings.intro
  if section.settings.localization_key != blank
    assign kicker_key = 'hp_pages.' | append: section.settings.localization_key | append: '.kicker'
    assign intro_key = 'hp_pages.' | append: section.settings.localization_key | append: '.intro'
    assign kicker = kicker_key | t
    assign intro = intro_key | t
  endif
%}
<section class="hp hp-page" aria-labelledby="hp-page-title-{{ section.id }}">
  <div class="hp-shell">
    <nav class="hp-breadcrumbs" aria-label="{{ 'hp_store.common.home' | t }}">
      <a href="{{ routes.root_url }}">{{ 'hp_store.common.home' | t }}</a><span aria-hidden="true">/</span><span>{{ page.title | escape }}</span>
    </nav>
    <header class="hp-page__header">
      <p class="hp-eyebrow">{{ kicker | escape }}</p>
      <h1 id="hp-page-title-{{ section.id }}">{{ page.title | escape }}</h1>
      {% if intro != blank %}<p class="hp-copy">{{ intro | escape }}</p>{% endif %}
    </header>
    <div class="hp-page__layout">
      <article class="hp-article">
        {% if section.settings.show_draft %}
          <div class="hp-draft"><strong>{{ 'hp_store.common.draft' | t }}</strong><p>{{ 'hp_store.common.draft_copy' | t }}</p></div>
        {% endif %}
        {{ page.content }}
      </article>
      {% if section.settings.show_support %}
        <aside class="hp-aside">
          <h2>{{ 'hp_store.common.question' | t }}</h2>
          <p>{{ 'hp_store.common.support_copy' | t }}</p>
          <a class="hp-button" href="{{ routes.root_url | append: '/pages/contact' | replace: '//', '/' }}">{{ 'hp_store.common.contact' | t }}</a>
          <nav aria-label="{{ 'hp_store.common.support' | t }}">
            <a href="{{ routes.root_url | append: '/pages/shipping' | replace: '//', '/' }}">{{ 'hp_store.common.shipping' | t }}</a>
            <a href="{{ routes.root_url | append: '/pages/returns' | replace: '//', '/' }}">{{ 'hp_store.common.returns' | t }}</a>
            <a href="{{ routes.root_url | append: '/pages/track-order' | replace: '//', '/' }}">{{ 'hp_store.common.track' | t }}</a>
          </nav>
        </aside>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{"name":"t:hp_store.name","settings":[{"type":"text","id":"localization_key","label":"t:hp_store.localization_key","info":"t:hp_store.localization_info"},{"type":"text","id":"kicker","label":"t:hp_store.kicker"},{"type":"textarea","id":"intro","label":"t:hp_store.copy"},{"type":"checkbox","id":"show_draft","label":"t:hp_store.draft","default":false},{"type":"checkbox","id":"show_support","label":"t:hp_store.show_support","default":true}],"presets":[{"name":"t:hp_store.name"}]}
{% endschema %}
