<section class="hp hp-password">
  <div class="hp-password__inner">
    <a class="hp-wordmark" href="{{ routes.root_url }}">{{ 'hiparcelo.brand.prefix' | t }}<span>{{ 'hiparcelo.brand.suffix' | t }}</span></a>
    <p class="hp-eyebrow">{{ 'hp_store.password.eyebrow' | t }}</p>
    <h1>{{ 'hp_store.password.heading' | t }}</h1>
    <p class="hp-copy">{{ 'hp_store.password.copy' | t }}</p>
    <details>
      <summary>{{ 'hp_store.password.enter' | t }}</summary>
      {% form 'storefront_password' %}
        {% if form.errors %}<p role="alert">{{ 'hp_store.password.error' | t }}</p>{% endif %}
        <div class="hp-field"><label for="HpStorePassword">{{ 'hp_store.password.password' | t }}</label><input id="HpStorePassword" type="password" name="password" autocomplete="current-password" required></div>
        <button type="submit" class="hp-button">{{ 'hp_store.password.open' | t }}</button>
      {% endform %}
    </details>
    <p class="hp-password__owner">{{ 'hp_store.password.owner' | t }} <a href="/admin">{{ 'hp_store.password.login' | t }}</a></p>
    <p class="hp-password__privacy">{{ 'hp_store.password.privacy' | t }}</p>
  </div>
</section>
{% schema %}
{"name":"t:hp_store.password_name","settings":[],"presets":[{"name":"t:hp_store.password_name"}]}
{% endschema %}
