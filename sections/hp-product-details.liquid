{% if section.blocks.size > 0 %}
<section class="hp hp-product-facts" aria-labelledby="hp-facts-title-{{ section.id }}">
  <div class="hp-shell">
    <header class="hp-product-facts__head"><p class="hp-eyebrow">{{ 'hp_store.product.facts_kicker' | t }}</p><h2 id="hp-facts-title-{{ section.id }}">{{ 'hp_store.product.details' | t }}</h2></header>
    <div class="hp-fact-grid">{% for block in section.blocks %}{% if block.settings.body != blank %}<article class="hp-fact" {{ block.shopify_attributes }}><h3>{{ block.settings.heading | escape }}</h3><div class="hp-article">{{ block.settings.body }}</div></article>{% endif %}{% endfor %}</div>
  </div>
</section>
{% endif %}
{% schema %}
{"name":"t:hp_store.facts_name","settings":[],"blocks":[{"type":"detail","name":"t:hp_store.fact","settings":[{"type":"text","id":"heading","label":"t:hp_store.fact_heading"},{"type":"richtext","id":"body","label":"t:hp_store.fact_body","info":"t:hp_store.fact_info"}]}],"presets":[{"name":"t:hp_store.facts_name"}]}
{% endschema %}
