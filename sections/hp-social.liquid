<section class="hi hi-page hi-social" aria-labelledby="hi-social-title">
  <div class="hi-page__cover"><div class="hi-wrap">
    <div class="hi-page__title">
      <span>{{ 'hp_social.kicker' | t }}</span>
      <h1 id="hi-social-title">{{ 'hp_content.social.title' | t }}</h1>
      <p>{{ 'hp_social.intro' | t }}</p>
    </div>
  </div></div>
  <div class="hi-wrap hi-page__content"><div class="hi-prose">
    {{ 'hp_content.social.body_html' | t }}
  </div></div>
</section>
