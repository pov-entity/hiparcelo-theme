<section class="hp27 hp27-explore" id="hp27-explore" aria-labelledby="hp27-explore-title"><div class="hp27-wrap"><div class="hp27-overline"><span>01 / {{ 'hp27.explore_index' | t }}</span><span>{{ 'hp27.explore_right' | t }}</span></div><div class="hp27-section-intro"><div><p class="hp27-eyebrow">{{ 'hp27.explore_kicker' | t }}</p><h2 id="hp27-explore-title">{{ 'hp27.explore_heading' | t }}<em>{{ 'hp27.explore_emphasis' | t }}</em></h2></div><p>{{ 'hp27.explore_intro' | t }}</p></div>
<div class="hp27-explore__module" data-hp27-tabs><div class="hp27-explore__tabs" role="tablist" aria-label="{{ 'hp27.explore_tabs' | t }}">
<button type="button" role="tab" id="hp27-tab-1" aria-controls="hp27-panel-1" aria-selected="true" tabindex="0" data-hp27-tab="0" class="hp27-explore__tab is-active"><span>01 <i aria-hidden="true">↗</i></span><strong>{{ 'hp27.space_tab' | t }}</strong><small>{{ 'hp27.space_tab_sub' | t }}</small></button><button type="button" role="tab" id="hp27-tab-2" aria-controls="hp27-panel-2" aria-selected="false" tabindex="-1" data-hp27-tab="1" class="hp27-explore__tab "><span>02 <i aria-hidden="true">↗</i></span><strong>{{ 'hp27.time_tab' | t }}</strong><small>{{ 'hp27.time_tab_sub' | t }}</small></button><button type="button" role="tab" id="hp27-tab-3" aria-controls="hp27-panel-3" aria-selected="false" tabindex="-1" data-hp27-tab="2" class="hp27-explore__tab "><span>03 <i aria-hidden="true">↗</i></span><strong>{{ 'hp27.comfort_tab' | t }}</strong><small>{{ 'hp27.comfort_tab_sub' | t }}</small></button>
</div><div class="hp27-explore__viewport">
<div class="hp27-explore__panel hp27-explore__panel--space" role="tabpanel" id="hp27-panel-1" aria-labelledby="hp27-tab-1" ><div class="hp27-explore__orb" aria-hidden="true"><div class="hp27-explore__orb-inner">⌑</div></div><div class="hp27-explore__panel-info"><span>HP / 001 — {{ 'hp27.explore_concept' | t }}</span><h3>{{ 'hp27.space_big' | t }}</h3><p>{{ 'hp27.space_copy' | t }}</p><a href="{{ routes.root_url | append: '/pages/guide-fit' | replace: '//', '/' }}">{{ 'hp27.space_link' | t }} ↗</a></div></div>
<div class="hp27-explore__panel hp27-explore__panel--time" role="tabpanel" id="hp27-panel-2" aria-labelledby="hp27-tab-2" hidden><div class="hp27-explore__orb" aria-hidden="true"><div class="hp27-explore__orb-inner">↗</div></div><div class="hp27-explore__panel-info"><span>HP / 002 — {{ 'hp27.explore_concept' | t }}</span><h3>{{ 'hp27.time_big' | t }}</h3><p>{{ 'hp27.time_copy' | t }}</p><a href="{{ routes.root_url | append: '/pages/guide-before-ordering' | replace: '//', '/' }}">{{ 'hp27.time_link' | t }} ↗</a></div></div>
<div class="hp27-explore__panel hp27-explore__panel--comfort" role="tabpanel" id="hp27-panel-3" aria-labelledby="hp27-tab-3" hidden><div class="hp27-explore__orb" aria-hidden="true"><div class="hp27-explore__orb-inner">✳</div></div><div class="hp27-explore__panel-info"><span>HP / 003 — {{ 'hp27.explore_concept' | t }}</span><h3>{{ 'hp27.comfort_big' | t }}</h3><p>{{ 'hp27.comfort_copy' | t }}</p><a href="{{ routes.root_url | append: '/pages/guide-use-and-care' | replace: '//', '/' }}">{{ 'hp27.comfort_link' | t }} ↗</a></div></div>
</div></div><p class="hp27-explore__foot">{{ 'hp27.explore_foot' | t }}</p></div></section>
