{% doc %}
  Renders a decorative line icon beside accessible text.
  @param {string} name - Icon name: arrow, box, eye, heart, truck, returns, chat, menu or bag.
  @example
  {% render 'hp-icon', name: 'arrow' %}
{% enddoc %}
<svg class="hp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {% case name %}
    {% when 'arrow' %}<path d="M4 12h15m-6-6 6 6-6 6"/>
    {% when 'box' %}<path d="m12 3 9 5-9 5-9-5 9-5Zm-9 5v9l9 5 9-5V8M12 13v9M7.5 5.5l9 5"/>
    {% when 'eye' %}<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>
    {% when 'heart' %}<path d="M20.8 4.8a5.4 5.4 0 0 0-7.6 0L12 6l-1.2-1.2a5.4 5.4 0 0 0-7.6 7.6L12 21l8.8-8.6a5.4 5.4 0 0 0 0-7.6Z"/>
    {% when 'truck' %}<path d="M2 5h13v12H2V5Zm13 5h4l3 4v3h-7"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
    {% when 'returns' %}<path d="M4 8h10a6 6 0 0 1 0 12h-4M4 8l5-5M4 8l5 5"/>
    {% when 'chat' %}<path d="M21 11.5a9 9 0 0 1-9 8.5 10 10 0 0 1-4-.8L3 21l1.5-4.5A8 8 0 0 1 3 11.5 9 9 0 0 1 12 3a9 9 0 0 1 9 8.5Z"/>
    {% when 'menu' %}<path d="M4 6h16M4 12h16M4 18h16"/>
    {% when 'bag' %}<path d="M5 7h14l1 14H4L5 7Zm3 0V5a4 4 0 0 1 8 0v2"/>
  {% endcase %}
</svg>
